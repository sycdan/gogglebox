# Interpolation values docker-compose.base.yml requires, for the sandbox.
# scripts/e2e.sh loads this first, then the provisioned .env.sbx, which carries
# the real JELLYFIN_API_KEY and ACCESS_TOKEN. No secrets here.
JELLYFIN_URL=http://jellyfin-sandbox:8096
JELLYFIN_API_KEY=unprovisioned
SESSION_SECRET=gogglebox-e2e
GOGGLEBOX_PORT=8080
GOGGLEBOX_VERSION=e2e
